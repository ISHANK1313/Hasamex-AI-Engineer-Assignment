# Copy to .env and fill in. .env is gitignored; .env.example is committed.
# Every value here is OPTIONAL: the app runs fully without any key.

# Google Gemini via its OpenAI-compatible endpoint (free tier).
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.5-flash-lite

# Set to 1 to force offline mode with a canned response (no network, no key).
# Used by the test suite and by demoing the pipeline without a key.
MOCK_LLM=0

# Optional tuning.
LLM_TIMEOUT_S=30